# Copy this file to .env.local (already gitignored) and fill in values.
# .env.local is read by Expo when running `npm start`. For EAS builds,
# create the same names as secrets in your Expo dashboard:
#   eas secret:create --name SENTRY_DSN --value "https://..."
#
# Without these, the app still runs in dev — Sentry init is a no-op when
# SENTRY_DSN is missing, and the @sentry/react-native/expo config plugin
# is only registered when DSN + ORG + PROJECT are all present.

SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time only — needed for source-map upload during EAS builds.
SENTRY_AUTH_TOKEN=

# EAS project ID — copy from `eas init` output, or from the Expo dashboard.
EAS_PROJECT_ID=
